<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone: references the files in YOUR installed Terraria + TerrariaModder. No other repo needed.
       Override the install location with:  dotnet build -p:TerrariaDir="D:\Games\Terraria" -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OverlaySpike</AssemblyName>
    <RootNamespace>OverlaySpike</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TerrariaDir Condition="'$(TerrariaDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Terraria</TerrariaDir>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Terraria"><HintPath>$(TerrariaDir)\Terraria.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="TerrariaModder.Core"><HintPath>$(TerrariaDir)\TerrariaModder\core\TerrariaModder.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(TerrariaDir)\TerrariaModder\core\deps\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework"><HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics"><HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Xna.Framework.Game"><HintPath>C:\Windows\Microsoft.NET\assembly\GAC_32\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
